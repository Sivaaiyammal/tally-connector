# --- MEVA ERP connection ---
# The URL your MEVA ERP server is reachable at from this PC. If MEVA runs on a
# different machine than TallyPrime, use that machine's address, not localhost.
MEVA_API_BASE_URL=http://localhost:3000
# Must match CONNECTOR_API_KEY in MEVA ERP's own .env file.
MEVA_API_KEY=

# --- TallyPrime connection ---
TALLY_HOST=127.0.0.1
# TallyPrime > F1 (Help) > Settings > Connectivity > Client/Server configuration
# > TCP/IP port. Also enable "ODBC Server: On" there — that's what turns this
# port into the XML import gateway this connector posts to.
TALLY_PORT=9000
# Exact company name as it appears in TallyPrime (Gateway of Tally > top-left).
TALLY_COMPANY_NAME=

# --- Tally chart-of-accounts mapping ---
# These must be ledger/group names that ALREADY EXIST in your TallyPrime
# company — the connector does not create groups or tax/sales ledgers, only
# the records below (customers, suppliers, items, and vouchers that reference
# these). Check Gateway of Tally > Chart of Accounts and adjust these to match
# your setup exactly (case and spelling matter to Tally).
TALLY_DEBTORS_GROUP=Sundry Debtors
TALLY_CREDITORS_GROUP=Sundry Creditors
TALLY_STOCK_GROUP=Primary
TALLY_SALES_LEDGER=Sales Account
TALLY_PURCHASE_LEDGER=Purchase Account
TALLY_CGST_LEDGER=CGST
TALLY_SGST_LEDGER=SGST
TALLY_IGST_LEDGER=IGST
TALLY_ROUNDOFF_LEDGER=Round Off
TALLY_BANK_LEDGER=Bank Account
TALLY_CASH_LEDGER=Cash

# --- What to sync (set to false to skip an entity entirely) ---
SYNC_CUSTOMERS=true
SYNC_SUPPLIERS=true
SYNC_ITEMS=true
SYNC_SALES_INVOICES=true
SYNC_PURCHASE_INVOICES=true
SYNC_RECEIPTS=true
SYNC_STOCK_ADJUSTMENTS=true

# --- Timing ---
# How often to poll MEVA for new records, in seconds, when running as a
# background loop (`npm start` / the .exe with no arguments).
SYNC_INTERVAL_SECONDS=900
