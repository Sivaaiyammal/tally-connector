{
  "name": "tally-connector",
  "version": "1.0.0",
  "private": true,
  "description": "Pushes MEVA ERP data (customers, vendors, items, invoices, receipts, stock adjustments) into TallyPrime via its XML import gateway. Runs as a tray app with a settings GUI and a background sync loop.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/generate-icon.js",
    "cli": "node src/index.js",
    "cli:sync": "node src/index.js --once",
    "dist": "electron-builder"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mevaerp.tallyconnector",
    "productName": "Tally Connector",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tally Connector"
    }
  }
}
