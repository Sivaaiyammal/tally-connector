{
  "name": "tally-connector",
  "version": "1.0.0",
  "private": true,
  "description": "Pushes MEVA ERP data (customers, vendors, items, invoices, receipts, stock adjustments) into TallyPrime via its XML import gateway.",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "sync": "node src/index.js --once",
    "build": "pkg . --targets node20-win-x64 --output dist/tally-connector.exe"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.0.0"
  }
}
